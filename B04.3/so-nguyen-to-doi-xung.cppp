#include <bits/stdc++.h>
using namespace std;

bool isprime(long long a) {
    if (a==2) {
        return true;
    }
    if (a==1 || a%2==0 || a==0) {
        return false;
    }
    long long k=3;
    while (k*k<=a) {
        if (a%k==0) {
            return false;
        }
        k+=2;
    }
    return true;
}

long long doixung(long long a) {
    long long k=0;
    while (a>0) {
        k=k*10+(a%10);
        a/=10;
    }
    return k;
}

int main () {
    freopen("PPRIME.INP", "r", stdin);
    freopen("PPRIME.OUT", "w", stdout);
    long long n, i=1 ;
    cin >> n;
    if (n>=2) {
        cout << "2" << " ";
    }
    while(i<=n) {
        if (isprime(i) && isprime(doixung(i))) {
            cout << i << " ";
        }
        i+=2 ;
    }
}
